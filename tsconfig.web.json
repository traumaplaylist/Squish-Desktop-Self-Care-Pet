{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "include": [
    "src/renderer/**/*",
    "src/core/**/*",
    "src/preload/api.d.ts"
  ],
  "exclude": [
    "src/core/**/*.test.ts",
    "src/renderer/**/*.test.ts"
  ]
}
