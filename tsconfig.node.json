{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/core/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/i18n/*.json",
    "electron.vite.config.ts",
    "vitest.config.mts",
    "src/renderer/**/*.test.ts",
    "src/renderer/pet/breath.ts"
  ]
}
